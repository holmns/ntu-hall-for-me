# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > URI.
# Use the pooled (pgbouncer, port 6543) URI for the app.
DATABASE_URL=
# Direct (port 5432) connection, used by `prisma migrate` only. Optional if
# DATABASE_URL is already a direct connection.
DIRECT_URL=

# ---------------------------------------------------------------------------
# Auth (NextAuth.js v5 / Auth.js, Google OAuth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Google Maps
# ---------------------------------------------------------------------------
# Server-side key. Needs: Places API (New) + Distance Matrix API.
# Used for address autocomplete and the one-time commute computation on create.
GOOGLE_MAPS_API_KEY=
# Browser key for the Maps JavaScript API (renders the map pin on listing
# detail). Safe to expose, but restrict it by HTTP referrer in the console.
# Can be the same key as above if you do not restrict it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers (Maps JS SDK > Map IDs, Vector, no cloud style
# needed). Falls back to Google's public "DEMO_MAP_ID" if unset - fine for
# local dev, but get a real one for production.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---------------------------------------------------------------------------
# LLM (OpenRouter) - query parsing + match ranking
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Optional. Defaults to google/gemini-2.5-flash-lite (fastest measured).
# Alternatives: anthropic/claude-haiku-4.5, google/gemini-2.5-flash
# Check https://openrouter.ai/api/v1/models - retired IDs 404 silently.
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Supabase Storage - listing photos
# ---------------------------------------------------------------------------
# Project URL, e.g. https://<ref>.supabase.co. Also used by the Realtime chat
# stretch goal below.
NEXT_PUBLIC_SUPABASE_URL=
# Service role key. SERVER ONLY - it bypasses RLS, so never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
# Without it the photo uploader disappears from the post form and listings are
# text and tags only, same as the other optional keys.
SUPABASE_SERVICE_ROLE_KEY=
#
# Requires a public bucket named `listing-images`:
#   Storage > New bucket > name "listing-images", Public, 5MB limit,
#   allowed MIME types image/*
# A `listing-videos` bucket exists for a future video feature; nothing uses it
# yet.

# ---------------------------------------------------------------------------
# Supabase Realtime (only needed if you replace the polling chat)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=
