# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > URI.
# Use the pooled (pgbouncer, port 6543) URI for the app.
DATABASE_URL=
# Direct (port 5432) connection, used by `prisma migrate` only. Optional if
# DATABASE_URL is already a direct connection.
DIRECT_URL=

# ---------------------------------------------------------------------------
# Auth (NextAuth.js v5 / Auth.js, Google OAuth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Google Maps
# ---------------------------------------------------------------------------
# Server-side key. Needs: Places API (New) + Distance Matrix API.
# Used for address autocomplete and the one-time commute computation on create.
GOOGLE_MAPS_API_KEY=
# Browser key for the Maps JavaScript API (renders the map pin on listing
# detail). Safe to expose, but restrict it by HTTP referrer in the console.
# Can be the same key as above if you do not restrict it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# LLM (OpenRouter) - query parsing + match ranking
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Optional. Defaults to google/gemini-2.5-flash-lite (fastest measured).
# Alternatives: anthropic/claude-haiku-4.5, google/gemini-2.5-flash
# Check https://openrouter.ai/api/v1/models - retired IDs 404 silently.
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Supabase (only needed if you enable Realtime chat instead of polling)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
