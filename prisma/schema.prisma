// NTU Room Finder - data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SEEKER
  PROVIDER
  BOTH
}

enum ListingCategory {
  ON_CAMPUS
  OFF_CAMPUS
}

enum RoomType {
  SINGLE
  SHARED
  WHOLE_UNIT
}

enum ListingStatus {
  ACTIVE
  INACTIVE
}

/// Fixed tag vocabulary. Providers pick from these checkboxes; the seeker query
/// parser is also constrained to this list so hard filtering stays exact-match.
enum ListingTag {
  AIRCON
  ENSUITE
  FURNISHED
  WIFI_INCLUDED
  UTILITIES_INCLUDED
  PET_FRIENDLY
  COOKING_ALLOWED
  WASHING_MACHINE
  STUDY_DESK
  NEAR_MRT
  QUIET
  NO_AGENT_FEE
  SHORT_LEASE
  LONG_LEASE
  FEMALE_ONLY
  MALE_ONLY
  ANY_GENDER
}

// ---------------------------------------------------------------------------
// Auth + users
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(SEEKER)
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  listings         Listing[]
  saved            SavedListing[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

model Listing {
  id          String          @id @default(cuid())
  providerId  String
  title       String
  description String
  category    ListingCategory
  /// Monthly rent in SGD.
  price       Int
  roomType    RoomType
  tags        ListingTag[]

  /// The terms a room-share seeker decides on, and the first thing they ask
  /// about if it is missing. All nullable: a provider who does not know yet
  /// should be able to publish, and the twenty seeded rows predate them. The
  /// listing page prints "Ask the provider" rather than inventing a value.
  ///
  /// Deliberately NOT in the embedding, which covers the public prose only -
  /// see the note on `embedding`. Dates and deposits are structured facts to
  /// filter on, and putting them in the vector space would only add noise.
  ///
  /// `deposit` and `housemates` distinguish null from 0: no deposit and living
  /// alone are both real answers, and neither means "unstated".
  availableFrom DateTime?
  minTermMonths Int?
  maxTermMonths Int?
  /// Security deposit in SGD, usually a multiple of the monthly rent.
  deposit       Int?
  /// How many other people already live there. 0 means the seeker would be
  /// alone, which is a selling point rather than a missing answer.
  housemates    Int?

  /// Exact address, shown publicly on the listing and used for the map pin.
  address String
  /// Exact coordinates. Public: every map in the app renders this point.
  lat     Float
  lng     Float

  /// Commute to NTU main campus, computed ONCE at creation via Distance Matrix
  /// and cached here. Search never calls a Maps API. On-campus listings are
  /// stored as 0 and excluded from distance-based ranking.
  distanceWalkingMin Int
  distanceTransitMin Int
  distanceDrivingMin Int
  distanceMeters     Int

  /// Semantic vector over the PUBLIC text only (title, description, tags, room
  /// type, category, price band) - never the address or coordinates, which are
  /// gated behind a mutual chat. 1536 dims to match text-embedding-3-small.
  ///
  /// Prisma has no native vector type, so this is Unsupported: it cannot be
  /// selected or written through the client. `src/lib/embeddings.ts` writes it
  /// with $executeRaw and `runFilter` orders by it with $queryRaw. Nullable
  /// because a row exists before it is embedded, and rows that fail to embed
  /// still belong in results - they sort last rather than disappearing.
  embedding      Unsupported("vector(1536)")?
  /// Which model produced `embedding`. A model swap changes the vector space,
  /// so this is what makes stale rows findable instead of silently mismatched.
  embeddingModel String?
  embeddedAt     DateTime?

  status    ListingStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  provider User           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  messages Message[]
  images   ListingImage[]
  savedBy  SavedListing[]

  @@index([status, category, price])
  @@index([providerId])
}

/// A room a seeker bookmarked.
///
/// Private to the seeker: the provider is not told, and nothing about saving
/// feeds back into ranking. It is a shortlist, not a signal.
model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// One save per person per room, and the upsert key the toggle relies on.
  @@unique([userId, listingId])
  /// Most recently saved first, which is the order the saved list renders in.
  @@index([userId, createdAt])
}

/// One photo of a listing. The bytes live in Supabase Storage (public bucket
/// `listing-images`); this row holds the URL and the display metadata.
model ListingImage {
  id          String   @id @default(cuid())
  listingId   String
  /// Public URL to render. The bucket is public, so this is a plain CDN URL
  /// with no signing and no expiry.
  url         String
  /// Object path inside the bucket, `<listingId>/<uuid>.<ext>`, needed to
  /// delete the object later. Nullable so a row can point at an image this app
  /// does not own.
  storagePath String?
  mimeType    String
  width       Int
  height      Int
  alt         String
  /// Display order. 0 is the cover shown on cards and search results.
  position    Int
  createdAt   DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

model Message {
  id         String   @id @default(cuid())
  listingId  String
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender   User    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([receiverId])
}
